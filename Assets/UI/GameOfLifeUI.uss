/* Rules are scoped under .card so they outrank the default runtime theme's single-class selectors.
   Colours inside the card are kept opaque so the panel reads the same over live and dead cells. */

:root {
    --text: rgb(237, 237, 240);
    --text-muted: rgb(158, 158, 166);
    --text-faint: rgb(112, 112, 122);
    --surface: rgba(22, 23, 28, 0.92);
    --border: rgb(58, 59, 68);
    --control: rgb(48, 49, 57);
    --control-hover: rgb(62, 63, 72);
    --selected: rgb(94, 95, 105);
    --track: rgb(70, 71, 81);
    --accent: rgb(10, 132, 255);
    --accent-hover: rgb(42, 150, 255);
    --good: rgb(48, 209, 88);
    --ok: rgb(255, 214, 10);
    --bad: rgb(255, 69, 58);
}

.hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: flex-start;
    padding: 12px;
}

.card {
    width: 256px;
    padding: 12px 14px 10px 14px;
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--border);
    border-radius: 12px;
}

.card .unity-label {
    margin: 0;
    padding: 0;
    color: var(--text);
    font-size: 13px;
}

/* Header */

.card .header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
}

.card .title {
    font-size: 17px;
    -unity-font-style: bold;
}

.card .fps-badge {
    flex-direction: row;
    align-items: center;
    padding: 2px 7px;
    border-radius: 6px;
    background-color: var(--control);
}

.card .fps-value {
    min-width: 24px;
    margin-right: 4px;
    -unity-text-align: middle-right;
    -unity-font-style: bold;
    color: var(--text-muted);
    transition-property: color;
    transition-duration: 0.3s;
}

.card .fps-unit {
    font-size: 11px;
    color: var(--text-faint);
}

.card .fps--good .fps-value {
    color: var(--good);
}

.card .fps--ok .fps-value {
    color: var(--ok);
}

.card .fps--bad .fps-value {
    color: var(--bad);
}

/* Action buttons */

.card .actions {
    flex-direction: row;
    margin-bottom: 10px;
}

.card .action {
    flex-grow: 1;
    height: 28px;
    margin: 0 6px 0 0;
    padding: 0 8px;
    border-width: 0;
    border-radius: 6px;
    background-color: var(--control);
    color: var(--text);
    font-size: 13px;
    -unity-font-style: bold;
    transition-property: background-color;
    transition-duration: 0.12s;
}

.card .action--last {
    margin-right: 0;
}

.card .action:hover {
    background-color: var(--control-hover);
}

.card .action:active {
    background-color: var(--selected);
}

.card .action--play {
    min-width: 64px;
}

.card .action--accent {
    background-color: var(--accent);
    color: rgb(255, 255, 255);
}

.card .action--accent:hover,
.card .action--accent:hover:active {
    background-color: var(--accent-hover);
}

/* Label / control rows */

.card .row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}

.card .row--slider {
    margin-top: 2px;
    margin-bottom: 2px;
}

.card .row-label {
    color: var(--text-muted);
}

.card .row-value {
    -unity-font-style: bold;
}

/* Segmented control */

.card .segmented {
    flex-direction: row;
    width: 140px;
    padding: 2px;
    border-radius: 8px;
    background-color: var(--control);
}

.card .segment {
    flex-grow: 1;
    flex-basis: 0;
    height: 26px;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 6px;
    background-color: rgba(0, 0, 0, 0);
    color: var(--text-muted);
    font-size: 13px;
    -unity-font-style: bold;
    transition-property: background-color, color;
    transition-duration: 0.12s;
}

.card .segment:hover {
    background-color: var(--control-hover);
    color: var(--text);
}

.card .segment:active {
    background-color: var(--selected);
}

.card .segment--selected,
.card .segment--selected:hover {
    background-color: var(--selected);
    color: var(--text);
}

/* Slider */

.card .size-slider {
    margin: 0;
    padding: 0;
    height: 22px;
}

.card .size-slider .unity-base-slider__input {
    margin: 0;
    padding: 0;
}

.card .size-slider .unity-base-slider__tracker {
    top: 50%;
    height: 4px;
    margin-top: -2px;
    left: 0;
    right: 0;
    border-width: 0;
    border-radius: 2px;
    background-color: var(--track);
}

.card .size-slider .unity-base-slider__fill {
    border-radius: 2px;
    background-color: var(--accent);
}

.card .size-slider .unity-base-slider__dragger {
    top: 50%;
    width: 16px;
    height: 16px;
    margin-top: -8px;
    margin-left: 0;
    border-width: 0;
    border-radius: 8px;
    background-color: rgb(255, 255, 255);
    transition-property: scale;
    transition-duration: 0.1s;
}

.card .size-slider:hover .unity-base-slider__dragger {
    scale: 1.12 1.12;
}

.card .size-slider .unity-base-slider__dragger-border {
    display: none;
}

.card .slider-range {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 10px;
}

.card .slider-range-label {
    font-size: 11px;
    color: var(--text-faint);
}

/* Keybind list */

.card .keys {
    padding-top: 8px;
    border-top-width: 1px;
    border-color: var(--border);
}

.card .key-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
}

.card .key-row--last {
    margin-bottom: 0;
}

.card .key-action {
    font-size: 12px;
    color: var(--text-muted);
}

.card .key {
    min-width: 18px;
    padding: 1px 5px;
    border-width: 1px;
    border-color: var(--border);
    border-radius: 4px;
    background-color: var(--control);
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--text-muted);
}
