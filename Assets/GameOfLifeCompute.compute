RWStructuredBuffer<uint> gridOut;
StructuredBuffer<uint> gridIn;
uint rng_state;
uint width;
uint gridWidth;
uint height;

// Wide groups so each SIMD group reads whole cache lines of a row. 256 threads is WebGPU's default limit
#define groupSizeX 64
#define groupSizeY 4

void setBit(inout uint input, uint pos) {
  input |= (1 << pos);
}

void clearBit(inout uint input, uint pos) {
  input &= ~(1 << pos);
}

uint lastWordMask() {
  return 0xFFFFFFFF >> (gridWidth * 32 - width);
}

// Adds three bits in each of the 32 lanes at once
void fullAdd(uint a, uint b, uint c, out uint sum, out uint carry) {
  uint ab = a ^ b;
  sum = ab ^ c;
  carry = (a & b) | (ab & c);
}

#pragma kernel Update // ID 0
[numthreads(groupSizeX, groupSizeY, 1)]
void Update(uint3 id : SV_DispatchThreadID) {
  if (id.x >= gridWidth || id.y >= height) {
    return;
  }

  uint index = id.y * gridWidth + id.x;

  uint hasTop = id.y > 0;
  uint hasBottom = id.y < height - 1;
  uint hasLeft = id.x > 0;
  uint hasRight = id.x < gridWidth - 1;
  uint above = index - hasTop * gridWidth;
  uint below = index + hasBottom * gridWidth;

  // Get neighbouring indexes
  uint topLeft = gridIn[above - hasLeft] * (hasTop & hasLeft);
  uint top = gridIn[above] * hasTop;
  uint topRight = gridIn[above + hasRight] * (hasTop & hasRight);
  uint left = gridIn[index - hasLeft] * hasLeft;
  uint cell = gridIn[index];
  uint right = gridIn[index + hasRight] * hasRight;
  uint bottomLeft = gridIn[below - hasLeft] * (hasBottom & hasLeft);
  uint bottom = gridIn[below] * hasBottom;
  uint bottomRight = gridIn[below + hasRight] * (hasBottom & hasRight);

  // Shift each neighbour into line with the cell it borders (bit i is cell i), then sum all 32 cells' neighbour
  // counts in parallel as bit planes rather than looping over the bits
  uint topSum, topCarry, bottomSum, bottomCarry;
  fullAdd((top << 1) | (topLeft >> 31), top, (top >> 1) | (topRight << 31), topSum, topCarry);
  fullAdd((bottom << 1) | (bottomLeft >> 31), bottom, (bottom >> 1) | (bottomRight << 31), bottomSum, bottomCarry);
  uint cellLeft = (cell << 1) | (left >> 31);
  uint cellRight = (cell >> 1) | (right << 31);
  uint middleSum = cellLeft ^ cellRight;
  uint middleCarry = cellLeft & cellRight;

  uint ones, twosA, twosB, fours;
  fullAdd(topSum, middleSum, bottomSum, ones, twosA);
  fullAdd(topCarry, middleCarry, bottomCarry, twosB, fours);

  // 3 neighbours, or 2 if already alive: one twos carry, no fours, and either the ones bit or the cell itself
  uint output = (ones | cell) & (twosA ^ twosB) & ~fours;

  if (id.x == gridWidth - 1) {
    output &= lastWordMask();
  }

  gridOut[index] = output;
}

uint pcg_hash(uint input) {
  uint state = input * 747796405u + 2891336453u;
  uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
  return ((word >> 22u) ^ word);
}

#pragma kernel Generate // ID 1
[numthreads(groupSizeX, groupSizeY, 1)]
void Generate(uint3 id : SV_DispatchThreadID) {
  if (id.x >= gridWidth || id.y >= height) {
    return;
  }

  uint index = id.y * gridWidth + id.x;
  uint cells = pcg_hash(rng_state + index);
  if (id.x == gridWidth - 1) {
    cells &= lastWordMask();
  }
  gridOut[index] = cells;
}

#pragma kernel Clear // ID 2
[numthreads(groupSizeX, groupSizeY, 1)]
void Clear(uint3 id : SV_DispatchThreadID) {
  if (id.x >= gridWidth || id.y >= height) {
    return;
  }

  uint index = id.y * gridWidth + id.x;
  gridOut[index] = 0;
}

float2 mousePos;
bool erase;
#pragma kernel Draw // ID 3
[numthreads(1, 1, 1)]
void Draw(uint3 id : SV_DispatchThreadID) {
  int yPos = floor(mousePos.y * 64 + height / 2.0);
  int xPos = floor(mousePos.x * 64 + width / 2.0);

  // Don't allow drawing out of bounds
  if (xPos < 0 || xPos >= (int)width || yPos < 0 || yPos >= (int)height) {
    return;
  }

  uint bitPos = (uint)xPos % 32;
  uint gridIndex = (uint)yPos * gridWidth + (uint)xPos / 32;

  if (erase) {
    clearBit(gridOut[gridIndex], bitPos);
  } else {
    setBit(gridOut[gridIndex], bitPos);
  }
}